// Modelo Task - estructura existente
model Task {
  id         Int       @id @default(autoincrement())
  lead_id    Int?
  contact_id Int?
  tarea      String?
  pendiente  Boolean   @default(true)
  fecha      DateTime?
  lead       Lead?     @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  contact    Contact?  @relation(fields: [contact_id], references: [id], onDelete: SetNull)

  @@map("tasks")
}

// ============================================
// SISTEMA DE FACTURACIÓN SIMPLE
// ============================================

// Factura - TODO en una sola tabla
model Invoice {
  id                Int       @id @default(autoincrement())
  invoice_number    String    @unique
  client_name       String
  client_company_name String?   @db.Text
  client_email      String?
  client_address    String?   @db.Text
  client_tax_id     String?
  company_name      String?   @default("BUFFALO AI")
  company_address   String?   @db.Text
  issue_date        DateTime  @default(now()) @db.Date
  due_date          DateTime? @db.Date
  services          Json?     @db.JsonB // Array de servicios
  subtotal          Decimal   @default(0) @db.Decimal(10, 2)
  iva               Decimal   @default(0) @db.Decimal(10, 2)
  total             Decimal   @default(0) @db.Decimal(10, 2)
  status            String    @default("draft") // draft, sent, cancelled
  pdf_drive_file_id String?
  pdf_drive_url     String?   @db.Text
  sent_to_drive     Boolean?  @default(false)
  bank_transaction_id String?  @db.Uuid // Movimiento bancario (cobro) vinculado a esta factura
  crm_user_id       Int?
  invoice_source    String    @default("client") // client | developer
  developer_pdf_path String?  @db.Text
  deleted_at        DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@index([invoice_number])
  @@index([bank_transaction_id])
  @@index([status])
  @@index([deleted_at])
  @@index([issue_date])
  @@map("invoices")
}

// Plantilla HTML (opcional - solo si quieres guardarla en BD)
model InvoiceTemplate {
  id          Int      @id @default(1)
  html_content String  @db.Text
  updated_at   DateTime @updatedAt

  @@map("invoice_template")
}

// ============================================
// SISTEMA DE PIPELINES KANBAN (MVP)
// ============================================
// Sistema simple tipo GoHighLevel/Holded
// Solo 2 tablas, sin overengineering

model PipelineKanban {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  entity_type String   // 'client' | 'contact'
  created_at  DateTime @default(now())

  cards       PipelineCard[]
  stages      PipelineStage[]

  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid()) @db.Uuid
  pipeline_id String   @db.Uuid
  name        String
  color       String   @default("#3B82F6")
  position    Int      @default(0)
  created_at  DateTime @default(now())

  pipeline    PipelineKanban @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)

  @@unique([pipeline_id, name])
  @@index([pipeline_id, position])
  @@map("pipeline_stages")
}

model PipelineCard {
  id            String    @id @default(uuid()) @db.Uuid
  pipeline_id   String    @db.Uuid
  entity_id     String    @db.Text // ID del contacto o cliente (referencia externa) - almacenado como TEXT
  entity_type   String    // 'client' | 'contact'
  stage         String    // Nombre de la columna
  stage_color   String?   // Color de la columna (hex) - nullable porque puede no tener default en BD
  position      Int       // Orden dentro de la columna - sin default porque puede no tenerlo en BD
  tags          String[]  // Array de etiquetas
  capture_date  DateTime? // Fecha de captación del lead
  amount        Decimal? @db.Decimal(10, 2) // Cantidad de dinero del objeto
  notes         String?  @db.Text // Notas adicionales
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  pipeline      PipelineKanban @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)

  @@index([pipeline_id])
  @@index([stage])
  @@index([entity_id, entity_type])
  @@index([deleted_at])
  @@index([pipeline_id, stage, position])
  @@map("pipeline_cards")
}

// ============================================
// SISTEMA DE FINANZAS
// ============================================
// Gestión financiera visual y manual
// NO contabilidad oficial - solo para decisiones

// Gastos fijos mensuales (se repiten automáticamente)
model FixedExpense {
  id          Int      @id @default(autoincrement())
  name        String
  amount      Decimal  @db.Decimal(10, 2)
  has_iva     Boolean  @default(false)
  iva_percent Decimal? @db.Decimal(5, 2) // % IVA (21, 10, 4, etc.)
  is_active   Boolean  @default(true)
  tags        String[] // Array de etiquetas
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?

  @@index([is_active, deleted_at])
  @@map("fixed_expenses")
}

// Gastos manuales (freelancers, proveedores)
model Expense {
  id          Int      @id @default(autoincrement())
  name        String
  date_start  DateTime @db.Date // Fecha inicio del rango
  date_end    DateTime @db.Date // Fecha fin del rango
  base_amount Decimal  @db.Decimal(10, 2) // Base sin IVA
  iva_amount  Decimal  @default(0) @db.Decimal(10, 2) // IVA
  irpf_amount Decimal  @default(0) @db.Decimal(10, 2) // IRPF (retención)
  total_amount Decimal @db.Decimal(10, 2) // Total del gasto (puede incluir IRPF)
  tags        String[] // Array de etiquetas
  person_name String?  // Nombre de la persona/proveedor
  project     String?  // Proyecto asociado (opcional)
  client_name String?  // Cliente asociado (opcional)
  notes       String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?

  @@index([date_start])
  @@index([date_end])
  @@index([deleted_at])
  @@map("expenses")
}

// Nóminas / Pagos a socios (sin IVA)
model Salary {
  id          Int      @id @default(autoincrement())
  person_name String
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(10, 2)
  tags        String[] // Array de etiquetas
  notes       String?  @db.Text
  created_at DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?

  @@index([date])
  @@index([deleted_at])
  @@map("salaries")
}

// Ingresos (facturas reales o estimadas)
model FinancialIncome {
  id          Int      @id @default(autoincrement())
  client_name String
  date        DateTime @db.Date
  base_amount Decimal  @db.Decimal(10, 2) // Base sin IVA
  iva_amount  Decimal  @default(0) @db.Decimal(10, 2) // IVA
  total_amount Decimal @db.Decimal(10, 2) // Total con IVA
  status      String   @default("pending") // pending, paid, estimated
  project     String?  // Proyecto asociado (opcional)
  invoice_id  Int?     // ID de factura si está vinculada (opcional)
  notes       String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?

  @@index([date])
  @@index([status])
  @@index([deleted_at])
  @@map("financial_incomes")
}

// Configuración financiera (IVA, impuesto sociedades)
model FinancialSettings {
  id                    Int      @id @default(1)
  corporate_tax_percent  Decimal  @default(25) @db.Decimal(5, 2) // % Impuesto sociedades (15%, 25%, etc.)
  updated_at             DateTime @updatedAt

  @@map("financial_settings")
}

// ============================================
// EVALUACIÓN DE PROYECTOS (seguimiento + IA)
// ============================================
// Proyectos reales (activos o cerrados), bitácora periódica y análisis OpenRouter

model EvaluationProject {
  id          Int       @id @default(autoincrement())
  name        String
  client_name String?
  is_active   Boolean   @default(true)
  tags        String[]
  opened_at   DateTime  @default(now())
  closed_at   DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  entries   ProjectJournalEntry[]
  analyses  ProjectAiAnalysis[]

  @@index([deleted_at])
  @@index([is_active])
  @@map("evaluation_projects")
}

model ProjectJournalEntry {
  id         Int      @id @default(autoincrement())
  project_id Int
  body       String   @db.Text
  rating     Int?     // 1–5 opcional (nota del periodo para media del proyecto)
  created_at DateTime @default(now())

  project EvaluationProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("project_journal_entries")
}

model ProjectAiAnalysis {
  id           Int      @id @default(autoincrement())
  project_id   Int
  summary_json Json     @db.JsonB
  model        String?
  created_at   DateTime @default(now())

  project EvaluationProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("project_ai_analyses")
}

// ============================================
// COLD CALLING
// ============================================

model ColdCallProspect {
  id           Int      @id @default(autoincrement())
  nombre       String
  empresa      String?
  telefono     String?
  email        String?
  zona         String?
  sector       String?
  cargo        String?
  linkedin     String?
  web          String?
  estado       String   @default("pendiente") // pendiente | interesado | reunion_agendada | no_interesado | sin_respuesta | buzon_voz | no_contactar
  notas        String?  @db.Text
  assigned_to  String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  deleted_at   DateTime?

  calls        ColdCallCall[]

  @@index([estado])
  @@index([zona])
  @@index([sector])
  @@index([deleted_at])
  @@map("coldcall_prospects")
}

model ColdCallCall {
  id               Int       @id @default(autoincrement())
  prospect_id      Int
  fecha            DateTime  @default(now())
  duracion         Int?
  resultado        String    // interesado | no_interesado | sin_respuesta | buzon_voz | reunion_agendada | no_contactar
  notas            String?   @db.Text
  whatsapp_enviado Boolean   @default(false)
  email_enviado    Boolean   @default(false)
  reunion_fecha    DateTime?
  created_by_user_id Int?
  created_at       DateTime  @default(now())

  prospect         ColdCallProspect @relation(fields: [prospect_id], references: [id], onDelete: Cascade)

  @@index([prospect_id])
  @@index([fecha])
  @@index([resultado])
  @@map("coldcall_calls")
}

// ============================================
// MARKETING — ENGRANAJE 1
// ============================================

// Métricas mensuales por canal (mix de webhook + input manual)
model MarketingMetric {
  id              Int      @id @default(autoincrement())
  channel         String   // 'email_outreach' | 'meta_ads' | 'google_ads' | 'organic'
  period          String   // 'YYYY-MM'

  // Inversión (manual para ads; fija para email)
  spend           Decimal  @default(0) @db.Decimal(10, 2)

  // Email outreach — rellenado automáticamente por Instantly webhook
  emails_sent     Int      @default(0)
  contacts_sent   Int      @default(0)  // únicos (deduplicado por email+period)
  replies         Int      @default(0)
  interested      Int      @default(0)
  not_interested  Int      @default(0)
  bounced         Int      @default(0)
  unsubscribed    Int      @default(0)
  meetings_booked Int      @default(0)

  // Ads — input manual o webhook futuro
  impressions     Int?
  clicks          Int?

  notes           String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([channel, period])
  @@map("marketing_metrics")
}

// Contactos únicos alcanzados por email outreach (para deduplicar email_sent)
model MarketingOutreachContact {
  id      Int    @id @default(autoincrement())
  email   String
  period  String  // 'YYYY-MM'

  @@unique([email, period])
  @@map("marketing_outreach_contacts")
}

// Webhooks de Instantly (Email Outreach)
model InstantlyWebhook {
  id          Int       @id @default(autoincrement())
  event_type  String    // 'campaign_created', 'email_sent', 'bounce', 'reply', etc.
  email       String?
  campaign_id String?
  campaign_name String?
  payload     Json      // full payload from Instantly
  status      String?   // 'success', 'bounce', 'replied', etc.
  created_at  DateTime  @default(now())

  @@index([event_type])
  @@index([email])
  @@index([campaign_id])
  @@index([created_at])
  @@map("instantly_webhooks")
}

// ============================================
// ENGRANAJE 5 — RETENCIÓN
// ============================================

model Proyecto {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id             String    @db.Uuid
  name                  String
  service_type          String
  status                String    @default("development")
  launched_at           DateTime? @db.Date

  addon_outbound        Boolean   @default(false)
  addon_crm_integration Boolean   @default(false)
  addon_human_transfer  Boolean   @default(false)
  addon_email_summary   Boolean   @default(false)
  addon_transcription   Boolean   @default(false)
  addon_cloned_voice    Boolean   @default(false)
  addon_whatsapp        Boolean   @default(false)
  addon_web_widget      Boolean   @default(false)
  addon_form_trigger    Boolean   @default(false)
  addon_multimodal      Boolean   @default(false)
  addon_voice_in_chat   Boolean   @default(false)
  dashboard_tier        String?
  languages_count       Int       @default(1)

  cost_operator_hour_eur  Decimal? @db.Decimal(8, 2)
  operators_dedicated     Decimal? @db.Decimal(4, 1)
  hours_per_week_before   Decimal? @db.Decimal(6, 1)
  setup_fee_eur           Decimal? @db.Decimal(10, 2)
  monthly_fee_eur         Decimal? @db.Decimal(8, 2)
  has_mensualidad         Boolean  @default(false)
  maint_plan              String?
  has_voz                 Boolean  @default(false)
  has_chat                Boolean  @default(false)
  has_dash                Boolean  @default(false)
  has_pack                Boolean  @default(false)

  retell_agent_id       String?
  twilio_number         String?
  whatsapp_number       String?
  webhook_secret        String    @default(dbgenerated("gen_random_uuid()::TEXT"))

  lead_id               Int?      @unique
  contact_id            Int?
  config_ref            String?
  ticket_callback_url   String?
  ticket_callback_token String?

  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  engranaje5_data       Engranaje5Data[]
  engranaje5_kpis       Engranaje5Kpi[]
  tickets               Ticket[]
  ticket_field_discoveries TicketFieldDiscovery[]

  @@index([client_id])
  @@index([contact_id])
  @@index([service_type])
  @@index([status])
  @@index([has_mensualidad])
  @@map("proyectos")
}

model Engranaje5Data {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id                String   @db.Uuid
  year                      Int
  month                     Int

  total_interactions        Int?
  interactions_resolved     Int?
  interactions_escalated    Int?
  interactions_abandoned      Int?
  interactions_error        Int?

  calls_inbound             Int?
  calls_outbound            Int?
  avg_call_duration_s       Decimal? @db.Decimal(8, 2)
  total_call_minutes        Decimal? @db.Decimal(10, 2)
  avg_confidence_score      Decimal? @db.Decimal(4, 3)
  peak_calls_day            Int?
  peak_calls_hour           Int?
  transcriptions_stored     Int?
  cloned_voice_used_pct     Decimal? @db.Decimal(5, 4)
  human_transfers           Int?
  email_summaries_sent      Int?
  top_intents_json          Json?    @db.JsonB
  escalation_reasons_json   Json?    @db.JsonB

  conversations_whatsapp    Int?
  conversations_web         Int?
  conversations_form        Int?
  avg_messages_per_conv     Decimal? @db.Decimal(6, 2)
  avg_response_time_ms      Decimal? @db.Decimal(10, 2)
  avg_conv_duration_s       Decimal? @db.Decimal(8, 2)
  tokens_input_total        BigInt?
  tokens_output_total       BigInt?
  llm_cost_usd              Decimal? @db.Decimal(10, 4)
  conversations_outside_hours Int?
  top_topics_json           Json?    @db.JsonB
  multimodal_inputs         Int?

  sessions_total            Int?
  users_unique              Int?
  avg_session_duration_s    Decimal? @db.Decimal(8, 2)
  avg_page_views            Decimal? @db.Decimal(6, 2)
  conversions_total         Int?
  reports_exported          Int?
  sessions_mobile           Int?
  features_used_json        Json?    @db.JsonB
  days_inactive_streak      Int?

  infra_cost_usd            Decimal? @db.Decimal(10, 4)
  uptime_minutes            Int?
  downtime_minutes          Int?
  incidents_count           Int?     @default(0)
  improvements_applied      Int?     @default(0)

  nps_score_avg             Decimal? @db.Decimal(4, 2)
  nps_responses_count       Int?     @default(0)

  recorded_at               DateTime @default(now()) @db.Timestamptz(6)

  proyecto                  Proyecto @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, year, month])
  @@index([project_id])
  @@map("engranaje5_data")
}

model Engranaje5Kpi {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id          String   @db.Uuid
  year                Int
  month               Int

  kpi_key             String
  kpi_label           String
  kpi_category        String

  kpi_value           Decimal? @db.Decimal(15, 4)
  kpi_unit            String?
  kpi_value_label     String?

  chart_type          String
  is_star_kpi         Boolean  @default(false)
  visible_dashboard   Boolean  @default(true)
  visible_report      Boolean  @default(false)

  trend_vs_prev_month Decimal? @db.Decimal(8, 4)
  trend_direction     String?

  service_types       String[]
  formula_notes       String?
  computed_at         DateTime @default(now()) @db.Timestamptz(6)

  proyecto            Proyecto @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, year, month, kpi_key])
  @@index([project_id])
  @@map("engranaje5_kpis")
}

// ============================================
// TICKETS — Incidencias desde dashboards cliente
// ============================================

model Ticket {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id     String   @db.Uuid

  title          String
  description    String?
  priority       String   @default("medium")
  status         String   @default("open")

  reporter_name  String?
  reporter_email String?
  source         String   @default("dashboard")
  external_id    String?

  payload        Json     @default("{}") @db.JsonB
  custom_fields  Json     @default("{}") @db.JsonB

  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  proyecto       Proyecto @relation(fields: [project_id], references: [id], onDelete: Cascade)
  updates        TicketUpdate[]

  @@index([project_id])
  @@index([status])
  @@index([priority])
  @@index([created_at])
  @@map("tickets")
}

model TicketFieldDiscovery {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id       String   @db.Uuid
  field_key        String
  sample_value     String?
  occurrence_count Int      @default(1)
  first_seen_at    DateTime @default(now()) @db.Timestamptz(6)
  last_seen_at     DateTime @default(now()) @db.Timestamptz(6)

  proyecto         Proyecto @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, field_key])
  @@index([project_id])
  @@map("ticket_field_discoveries")
}

model TicketUpdate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id      String   @db.Uuid
  author_name    String?
  message        String
  status         String?
  is_from_client Boolean  @default(false)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  ticket         Ticket   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([created_at])
  @@map("ticket_updates")
}
