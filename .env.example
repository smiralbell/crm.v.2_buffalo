# SMTP (alertas y avisos internos del CRM)
SMTP_HOST=mail.agenciabuffalo.es
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@agenciabuffalo.es
SMTP_PASS=
SMTP_FROM=admin@agenciabuffalo.es
SMTP_FROM_NAME=Buffalo CRM

# Cal.com — reservas vía webhook (Marketing → Web). NO hace falta API key.
# Debe ser EXACTAMENTE el mismo secret que pones en Cal.com → Webhooks → Secret
CALCOM_WEBHOOK_SECRET=
# Filtro opcional: si NO los defines, se aceptan TODAS las reservas del webhook.
# Solo ponlos si quieres limitar a un evento concreto.
# CALCOM_EVENT_SLUG=reunion-agente-llamada
# CALCOM_EVENT_TYPE_ID=
# Pipelines por ID (recomendado: así puedes renombrar sin romper sync)
# WEB_PIPELINE_ID=
# COLDCALL_PIPELINE_ID=
# Emails (además de admin) que ven avisos de "preparar demo" para reuniones
# COLDCALL_DEMO_PREP_EMAILS=juan@agenciabuffalo.es
# Embudo global Buffalo LEADS-VENTA (columna REUNIÓN recibe WEB + Cold Calling)
GLOBAL_PIPELINE_ID=c900485d-7395-4def-9149-ef98f3d406ce

# Fireflies.ai — transcripciones y resúmenes de reuniones
# API key: https://app.fireflies.ai/integrations/api (o Integrations → Fireflies API)
FIREFLIES_API_KEY=
# Secret que configures en Fireflies → Webhooks V2 (firma X-Hub-Signature)
FIREFLIES_WEBHOOK_SECRET=
# Dominios internos a excluir del match automático (coma-separados)
# FIREFLIES_INTERNAL_EMAIL_DOMAINS=agenciabuffalo.es
#
# Webhook URL a pegar en Fireflies (producción):
#   {APP_BASE_URL}/api/webhooks/fireflies
# Eventos: meeting.transcribed , meeting.summarized

# ── Banco (Enable Banking) · sync automática diaria ─────────────────────
# El servidor sincroniza solo mientras corre (`npm start` / Docker).
# BANK_SYNC_SCHEDULER=0          # desactivar scheduler interno
# BANK_SYNC_MIN_HOURS=20         # mínimo entre syncs auto (default 20 ≈ 1/día)
# BANK_SYNC_CHECK_HOURS=1        # cada cuánto comprueba el scheduler
# Opcional: cron externo (EasyPanel / crontab / Vercel)
# CRON_SECRET=cambia-este-secreto
# GET/POST {APP_URL}/api/cron/bank-sync
#   Header: Authorization: Bearer <CRON_SECRET>
#   ?force=1  fuerza sync aunque sea reciente

# Demos WhatsApp RAG — embeddings (OpenRouter / OpenAI-compatible)
# DEMO_EMBEDDING_MODEL=openai/text-embedding-3-small
# DEMO_OPENROUTER_MODEL=openai/gpt-4o-mini

# ── OpenRouter · propuestas (editor / generación) ───────────────────────
# Rápido: parches triviales del chat editor
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Heavy: generación completa, traducir/regenerar todo el documento
# OPENROUTER_MODEL_HEAVY=~anthropic/claude-sonnet-latest

# ── Google Drive · facturas (gastos / emitidas) — reemplaza webhooks n8n ──
# 1) Misma cuenta OAuth que usaba n8n («Google Drive Buffalo»)
# 2) Visita (logueado en el CRM): /api/auth/google-drive
# 3) Copia el refresh token aquí
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_REDIRECT_URI=https://TU_DOMINIO/api/auth/google-drive/callback
# Carpetas padre en Drive (IDs de carpeta, no URLs)
# GOOGLE_DRIVE_PARENT_GASTOS=1K3e9uuW_VFGy_qr7PEr-Zzars6xvKzEF
# GOOGLE_DRIVE_PARENT_EMITIDAS=   # ID de FACTURAS/EMITIDAS (obligatorio para cobros/facturas)
