# SMTP (alertas y avisos internos del CRM)
SMTP_HOST=mail.agenciabuffalo.es
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@agenciabuffalo.es
SMTP_PASS=
SMTP_FROM=admin@agenciabuffalo.es
SMTP_FROM_NAME=Buffalo CRM

# Cal.com — reservas vía webhook (Marketing → Web). NO hace falta API key.
CALCOM_WEBHOOK_SECRET=
# Opcional: filtrar solo este evento (por defecto reunion-agente-llamada)
# CALCOM_EVENT_SLUG=reunion-agente-llamada
# CALCOM_EVENT_TYPE_ID=
